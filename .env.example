# identity
AGENT_ID=pip
PERSONA_PATH=./personas/pip.json

# env server
SERVER_URL=ws://localhost:4001

# only needed if the env server has ADMIN_TOKEN set (3eyes sim-server does
# when bound to 0.0.0.0), must match it exactly. leave empty on localhost
# ADMIN_TOKEN=

# local ollama, fallback only
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# groq. use it, ollama on a pi is ~30s a tick, groq ~2-3s
#
# diligence: ask 3eyes (iii@3eyes.world) for the prod key, it comes
# along with repo access. or make your own at groq.com, free tier, same limits
# CLOUD_API_KEY=gsk_xxx
# CLOUD_API_URL=https://api.groq.com/openai/v1/chat/completions
# CLOUD_MODEL=openai/gpt-oss-120b
# CLOUD_MODEL_FAST=openai/gpt-oss-20b

# timing
HEARTBEAT_MS=8000

# Memory
DATA_DIR=./data

# sleep
# ACTIVE_HOURS_BEFORE_SLEEP=4
# SLEEP_DURATION_MINUTES=60

# status api. give each pi its own port if they're on the same network
API_PORT=5000

# Logging
# LOG_LEVEL=info
